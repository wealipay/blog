{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public",
        "cleanUrls": true
      }
    }
  ],
  "routes": [
    {
      "src": "^/(.*)",
      "dest": "/$1"
    },
    {
      "src": "^/404/?$",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "cleanUrls": true
}